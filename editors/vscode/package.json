{
  "name": "lish-lsp-vscode",
  "displayName": "Lish",
  "description": "Language support for lish (diagnostics + semantic tokens via lish-lsp).",
  "version": "0.0.1",
  "publisher": "lish",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhogle25/lish-lsp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:lish"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lish",
        "aliases": [
          "Lish",
          "lish"
        ],
        "extensions": [
          ".lish",
          ".lishmacro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Lish",
      "properties": {
        "lish.server.path": {
          "type": "string",
          "default": "lish-lsp",
          "description": "Absolute path to the lish-lsp binary, or just the name if it's on $PATH."
        },
        "lish.run.path": {
          "type": "string",
          "default": "lish",
          "description": "Absolute path to the lish CLI binary used by 'Lish: Run File', or just the name if it's on $PATH. Point this at scripts/dev-run.sh for a build-then-run dev loop."
        },
        "lish.vocabulary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Paths to host-vocabulary JSON files produced by '<your-host> --dump-ops'. Absolute, or relative to the first workspace folder. Their ops appear in completion, hover, and signature help as if they were builtins, with full binding/scope analysis."
        }
      }
    },
    "commands": [
      {
        "command": "lish.run",
        "title": "Run File",
        "category": "Lish"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "lish.run",
          "when": "resourceExtname == .lish",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "lish.run",
          "when": "resourceExtname == .lish",
          "group": "navigation"
        }
      ],
      "editor/title/run": [
        {
          "command": "lish.run",
          "when": "resourceExtname == .lish",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "lish.run",
          "when": "resourceExtname == .lish"
        }
      ]
    },
    "configurationDefaults": {
      "[lish]": {
        "editor.formatOnType": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
