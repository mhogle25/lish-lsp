{
  "name": "lish-lsp-vscode",
  "displayName": "Lish",
  "description": "Language support for lish (diagnostics + semantic tokens via lish-lsp).",
  "version": "0.0.1",
  "publisher": "lish",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:lish"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lish",
        "aliases": ["Lish", "lish"],
        "extensions": [".lish", ".lishmacro"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Lish",
      "properties": {
        "lish.server.path": {
          "type": "string",
          "default": "lish-lsp",
          "description": "Absolute path to the lish-lsp binary, or just the name if it's on $PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
